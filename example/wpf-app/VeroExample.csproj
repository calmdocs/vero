<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>VeroExample</RootNamespace>
    <AssemblyName>VeroExample</AssemblyName>
  </PropertyGroup>
  <!-- In this repo the binding is two directories up; a copy of this app
       elsewhere has Vero.cs beside it, and picks that up instead. -->
  <ItemGroup Condition="!Exists('Vero.cs')">
    <Compile Include="../../bindings/csharp/Vero.cs" Link="Vero.cs"/>
  </ItemGroup>
</Project>
