<Window x:Class="VeroExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vero" Width="380" SizeToContent="Height"
        Background="#1C1C1E" WindowStyle="ToolWindow" ResizeMode="NoResize">

    <!-- The same shape as the macOS and GTK examples, in WPF. Only the drawing
         differs: the worker, the protocol and the state it publishes are
         identical, because it is the same Go program behind all three.

         Muted on purpose, and the same palette. Colour carries meaning rather
         than decorating: ordinary progress is neutral, because "looking for
         changes" is not a warning and should not look like one. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Text"    Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Muted"   Color="#949499"/>
        <SolidColorBrush x:Key="Card"    Color="#262628"/>
        <SolidColorBrush x:Key="Line"    Color="#333335"/>
        <SolidColorBrush x:Key="Active"  Color="#5C82B0"/>
        <SolidColorBrush x:Key="Done"    Color="#5C9E75"/>

        <!-- A real button, drawn flat. Hover, focus and the keyboard come from
             WPF; only the chrome is ours. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Header -->
        <Grid Margin="20,14">
            <TextBlock Text="vero" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource Text}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="JobCount" FontSize="12"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}"/>

        <!-- Jobs -->
        <ItemsControl x:Name="Jobs" Margin="16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Card}" CornerRadius="10"
                            Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource IconButton}"
                                    Click="Restart_Click" Tag="{Binding Id}"
                                    ToolTip="Restart" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontSize="20"
                                           Foreground="{StaticResource Muted}"/>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Text}"/>
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                            Background="{Binding BadgeBackground}">
                                        <TextBlock Text="{Binding Phase}" FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}"/>
                                    </Border>
                                </StackPanel>
                                <ProgressBar Value="{Binding Progress}" Maximum="100"
                                             Height="6" Margin="0,6,0,0"
                                             Background="#38383A"
                                             Foreground="{StaticResource Active}"
                                             BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer -->
        <Border Height="1" Background="{StaticResource Line}"/>
        <Grid Margin="20,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StateDot" Width="7" Height="7"
                         Fill="{StaticResource Done}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StateText" Margin="8,0,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Quit" FontSize="12" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       MouseLeftButtonUp="Quit_Click" Cursor="Hand"/>
        </Grid>
    </StackPanel>
</Window>
