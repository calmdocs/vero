<Window x:Class="VeroExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vero" Width="380" SizeToContent="Height" ResizeMode="NoResize">

    <!-- The same rows as the macOS and GTK examples: a Restart button, the
         job, the phase it is in, and how far through it is. -->
    <ItemsControl x:Name="Jobs" Margin="16">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The press. This goes to the "restartJob" handler in
                         main.go, and the reply is the new status. -->
                    <Button Grid.Column="0" Click="Restart_Click"
                            Tag="{Binding Id}" Content="Restart" Padding="8,3"/>

                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Phase}"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="Gray"/>
                    <ProgressBar Grid.Column="3" Value="{Binding Progress}"
                                 Maximum="100" Height="10" Margin="10,0,0,0"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
