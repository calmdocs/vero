<Window x:Class="VeroExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vero" Width="380" SizeToContent="Height" ResizeMode="NoResize">

    <!-- The same shape as the macOS and GTK examples, in WPF, with no styling:
         stock controls, stock colours. The worker, the protocol and the state
         it publishes are identical, because it is the same Go program behind
         all three. -->
    <StackPanel Margin="12">

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="vero" FontWeight="Bold" FontSize="15"/>
            <TextBlock x:Name="JobCount" HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <ItemsControl x:Name="Jobs">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- A real button: hover, focus and the keyboard all
                             come from WPF. -->
                        <Button Grid.Column="0" Click="Restart_Click"
                                Tag="{Binding Id}" Content="{Binding Icon}"
                                ToolTip="Restart" Padding="8,3"
                                VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Phase}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ProgressBar Value="{Binding Progress}" Maximum="100"
                                         Height="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,10"/>

        <DockPanel>
            <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center"/>
            <TextBlock x:Name="StateText" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Button Content="Quit" Click="Quit_Click" HorizontalAlignment="Right"
                    Padding="10,3"/>
        </DockPanel>

    </StackPanel>
</Window>
